  "info": {
    "title": "OST API",
    "description": "OST API endpoints",
    "version": "0.1",
    "contact": {}
  },
  "tags": [
    {
      "name": "ost",
      "description": ""
    }
  ],
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Backend server"
    }
  ],
  "components": {
    "schemas": {
      "SkeletonEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ske_[0-9a-fA-F]{32}$",
            "example": "ske_c54b633eb12f4900b92b34e222096449"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "myAttribute": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["id", "name", "description", "myAttribute"]
      },
      "CreateSkeletonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the skeleton",
            "example": "My Skeleton"
          },
          "description": {
            "type": "string",
            "description": "Description",
            "example": "The description of the skeleton",
            "nullable": true
          },
          "myAttribute": {
            "type": "string",
            "description": "A random attribute",
            "example": "Any random attribute",
            "nullable": true
          }
        },
        "required": ["name"]
      },
      "UpdateSkeletonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the skeleton",
            "example": "My Skeleton"
          },
          "description": {
            "type": "string",
            "description": "Description",
            "example": "The description of the skeleton",
            "nullable": true
          },
          "myAttribute": {
            "type": "string",
            "description": "A random attribute",
            "example": "Any random attribute",
            "nullable": true
          }
        }
      },
      "SocialLinkDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Type of social link",
            "enum": ["GITHUB", "TWITTER", "LINKEDIN", "DISCORD", "WEBSITE"],
            "example": "GITHUB"
          },
          "url": {
            "type": "string",
            "description": "URL of the social link (must match the domain of the type). Protocol is required, must use https://. Use empty string to delete the link.",
            "example": "https://github.com/username"
          }
        },
        "required": ["type", "url"]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "User name",
            "example": "John Doe"
          },
          "bio": {
            "type": "string",
            "description": "User bio",
            "example": "Software developer passionate about technology"
          },
          "jobTitle": {
            "type": "string",
            "description": "User job title",
            "example": "Senior Software Engineer"
          },
          "socialLinks": {
            "description": "User social links",
            "example": [
              {
                "type": "GITHUB",
                "url": "https://github.com/username"
              },
              {
                "type": "TWITTER",
                "url": "https://twitter.com/username"
              }
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialLinkDto"
            }
          }
        }
      }
    }
  }
}
