{
  "openapi": "3.0.0",
  "paths": {
    "/skeletons": {
      "get": {
        "description": "Get all skeletons",
        "operationId": "SkeletonController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SkeletonEntity"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "number",
                          "default": 1
                        },
                        "lastPage": {
                          "type": "number",
                          "default": 1
                        },
                        "currentPage": {
                          "type": "number",
                          "default": 1
                        },
                        "size": {
                          "type": "number",
                          "default": 10
                        }
                      }
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Get all skeletons",
        "tags": ["Skeleton"]
      },
      "post": {
        "description": "Create a new skeleton with the provided data",
        "operationId": "SkeletonController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSkeletonDto"
              },
              "examples": {
                "Complete example": {
                  "value": {
                    "name": "My Skeleton",
                    "description": "Description of the skeleton"
                  }
                },
                "Minimal example": {
                  "value": {
                    "name": "My Skeleton"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Skeleton created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SkeletonEntity"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2025-09-03T13:04:43.353Z"
                    }
                  },
                  "required": ["data", "timestamp"]
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        }
                      }
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Create a new skeleton",
        "tags": ["Skeleton"]
      }
    },
    "/skeletons/{id}": {
      "get": {
        "description": "Get a skeleton by id",
        "operationId": "SkeletonController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the skeleton",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SkeletonEntity"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2025-09-03T13:04:43.353Z"
                    }
                  },
                  "required": ["data", "timestamp"]
                }
              }
            }
          },
          "404": {
            "description": "Skeleton not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        }
                      }
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Get a skeleton by id",
        "tags": ["Skeleton"]
      },
      "patch": {
        "description": "Update an existing skeleton with the provided data",
        "operationId": "SkeletonController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Public ID of the skeleton to update",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSkeletonDto"
              },
              "examples": {
                "Update name and description": {
                  "value": {
                    "name": "Updated Skeleton",
                    "description": "Updated description"
                  }
                },
                "Update name only": {
                  "value": {
                    "name": "New Name"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Skeleton updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SkeletonEntity"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2025-09-03T13:04:43.353Z"
                    }
                  },
                  "required": ["data", "timestamp"]
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        }
                      }
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Skeleton not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        }
                      }
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Update a skeleton",
        "tags": ["Skeleton"]
      }
    },
